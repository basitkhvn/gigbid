  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
   },
   "inputSchema": {
    "$defs": {
     "DraftIn": {
      "properties": {
       "bid": {
        "description": "Bid in USD",
        "exclusiveMinimum": 0,
        "maximum": 1000000,
        "title": "Bid",
        "type": "number"
       },
       "cover_letter": {
        "maxLength": 5000,
        "minLength": 20,
        "title": "Cover Letter",
        "type": "string"
       },
       "dry_run": {
        "default": true,
        "description": "Preview only: returns what would be sent and its cost",
        "title": "Dry Run",
        "type": "boolean"
       },
       "idempotency_key": {
        "maxLength": 128,
        "minLength": 8,
        "title": "Idempotency Key",
        "type": "string"
       },
       "job_id": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Job Id",
        "type": "string"
       },
       "screening_answers": {
        "items": {
         "type": "string"
        },
        "maxItems": 10,
        "title": "Screening Answers",
        "type": "array"
       },
       "trace_id": {
        "default": "",
        "title": "Trace Id",
        "type": "string"
       },
       "user_id": {
        "description": "Tenant/user id",
        "maxLength": 64,
        "minLength": 1,
        "title": "User Id",
        "type": "string"
       }
      },
      "required": [
       "user_id",
       "job_id",
       "cover_letter",
       "bid",
       "idempotency_key"
      ],
      "title": "DraftIn",
      "type": "object"
     }
    },
    "properties": {
     "inp": {
      "$ref": "#/$defs/DraftIn"
     }
    },
    "required": [
     "inp"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   }
  },
