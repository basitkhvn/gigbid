 "components": {
  "schemas": {
   "Creds": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 120,
      "minLength": 5,
      "title": "Email"
     },
     "password": {
      "type": "string",
      "maxLength": 200,
      "minLength": 8,
      "title": "Password"
     },
     "persona": {
      "type": "string",
      "pattern": "^(ml|web|data)$",
      "title": "Persona",
      "default": "ml"
     }
    },
    "type": "object",
    "required": [
     "email",
     "password"
    ],
    "title": "Creds"
   },
   "Decision": {
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "approve",
       "edit",
       "reject"
      ],
      "title": "Action"
     },
     "text": {
      "type": "string",
      "maxLength": 6000,
      "title": "Text",
      "description": "edited text (action=edit)",
      "default": ""
     },
     "reason": {
      "type": "string",
      "maxLength": 500,
      "title": "Reason",
      "description": "required when rejecting",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "action"
    ],
    "title": "Decision"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ItemIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 2,
      "title": "Title"
     },
     "text": {
      "type": "string",
      "maxLength": 20000,
      "minLength": 20,
      "title": "Text"
     },
     "type": {
      "type": "string",
      "pattern": "^(case_study|readme|review|cv)$",
      "title": "Type",
      "default": "case_study"
     },
     "skills": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Skills",
      "default": []
     },
     "industry": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Industry"
     }
    },
    "type": "object",
    "required": [
     "title",
     "text"
    ],
    "title": "ItemIn"
   },
   "Regen": {
    "properties": {
     "paragraph": {
      "type": "string",
      "title": "Paragraph"
     },
     "instruction": {
      "type": "string",
      "title": "Instruction",
      "default": "Rewrite this paragraph more specifically; keep every [E#] citation valid; do not add new claims."
     }
    },
    "type": "object",
    "required": [
     "paragraph"
    ],
    "title": "Regen"
   },
   "SearchIn": {
    "properties": {
     "q": {
      "type": "string",
      "title": "Q",
      "default": ""
     },
     "category": {
      "type": "string",
      "title": "Category",
      "default": ""
     },
     "skill": {
      "type": "string",
      "title": "Skill",
      "default": ""
     },
     "interval_min": {
      "type": "integer",
      "maximum": 1440.0,
      "minimum": 60.0,
      "title": "Interval Min",
      "default": 240
     }
    },
    "type": "object",
    "title": "SearchIn"
   },
   "SettingsIn": {
    "properties": {
     "rate": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1000.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Rate"
     },
     "floor": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1000.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Floor"
     },
     "autonomy": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^(ask_always|auto_skip)$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Autonomy"
     },
     "weekly_connects_budget": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 2000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Weekly Connects Budget"
     },
     "marketplace": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^(gigsim|upwork_live)$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Marketplace"
     }
    },
    "type": "object",
    "title": "SettingsIn"
   },
   "TokenOut": {
    "properties": {
     "token": {
      "type": "string",
      "title": "Token"
     },
     "user_id": {
      "type": "string",
      "title": "User Id"
     },
     "email": {
      "type": "string",
      "title": "Email"
     },
     "persona": {
      "type": "string",
      "title": "Persona"
     }
    },
    "type": "object",
    "required": [
     "token",
     "user_id",
     "email",
     "persona"
    ],
    "title": "TokenOut"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  },
  "securitySchemes": {
   "HTTPBearer": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 }
}